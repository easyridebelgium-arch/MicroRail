extends SceneTree
const Demand = preload("res://scripts/core/passenger_demand.gd")
const Journeys = preload("res://scripts/core/passenger_journeys.gd")
const Ledger = preload("res://scripts/core/journey_ledger.gd")
const Amenities = preload("res://scripts/core/amenities.gd")
const Satisfaction = preload("res://scripts/core/passenger_satisfaction.gd")
const Response = preload("res://scripts/core/demand_response.gd")
const Arrival = preload("res://scripts/core/arrival_targets.gd")
const Occupancy = preload("res://scripts/core/passenger_occupancy.gd")
var checks := 0
var failures := 0
func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures += 1
		printerr("FAIL: " + message)
func _initialize() -> void: run.call_deferred()
func run() -> void:
	var ids := ["delta", "echo", "foxtrot", "golf"]
	var configs := {"passenger": {"stops": ["delta", "echo"]}, "passenger_1": {"stops": ["echo", "foxtrot", "golf"]}}
	var network := Journeys.graph(configs, ids)
	check(Journeys.plan(network, "delta", "golf") == ["delta", "echo", "golf"], "four-station graph finds physical interchange")
	check(Journeys.boarding(network, "delta", ["echo"]).has("golf"), "through passenger can board first leg to interchange")
	check(Journeys.plan(Journeys.graph({"passenger": configs.passenger}, ids), "delta", "golf").is_empty(), "withdrawn connection is unreachable")
	check(Journeys.plan(network, "missing", "missing").is_empty(), "unknown station cannot form a phantom journey")
	var demand := Demand.new(ids)
	for id in ids: demand.reset_total(id, 0)
	demand.queues.delta = {"golf": 2}
	demand.batches.delta = Demand.make_batches(demand.queues.delta, 60, "delta", true, ids)
	var manifest: Dictionary = {}
	var ledger := Ledger.new(ids)
	ledger.ensure("passenger", manifest, 60)
	check(demand.board("delta", ["echo", "golf"], 20, manifest, 60) == 2, "custom through passengers board")
	ledger.board("passenger", demand.last_journeys)
	var groups: Array = ledger.release("passenger", ["golf"])
	check(demand.interchange("echo", ["delta", "echo"], manifest, 120, groups) == 2 and manifest.is_empty(), "transfer retains final destination in interchange queue")
	ledger.ensure("passenger_1", {}, 120)
	demand.board("echo", ["foxtrot", "golf"], 20, manifest, 180)
	ledger.board("passenger_1", demand.last_journeys)
	check(ledger.aboard.passenger_1[0].origin == "delta" and ledger.aboard.passenger_1[0].start == 60, "original origin and clock survive transfer")
	var finished: Array = ledger.finish("passenger_1", "golf", manifest, 300)
	Demand.alight(manifest, "golf")
	check(finished.size() == 1 and ledger.completed[0].end == 300 and ledger.summary().contains("DELTA → GOLF"), "completed custom journey is measured and reported")
	var data := {"demand": {"primary": {}}, "services": configs, "passenger_services": {"passenger_1": {"passenger_destinations": {}}}, "state": {"passengers_delivered": 2}}
	var saved: Dictionary = ledger.save_state({"passenger": {}, "passenger_1": {}}, 300)
	check(Ledger.valid_save(saved, data, 300, ids) and not Ledger.valid_save(saved, data, 300), "journey save validates against supplied catalog")
	check(not Ledger.valid_save(saved, data, 300, ids + ["delta"]), "duplicate catalog identities rejected by journey validator")
	var copy := Ledger.new()
	copy.restore_state(JSON.parse_string(JSON.stringify(saved)), ids)
	check(copy.summary() == ledger.summary(), "journey history survives JSON restore")
	var bad: Dictionary = saved.duplicate(true)
	bad.completed[0].origin = "a"
	check(not Ledger.valid_save(bad, data, 300, ids), "foreign journey origin rejected")
	var amenities := Amenities.new(ids)
	check(amenities.buy("delta", "waiting_room", 1000) == -1, "custom station respects amenity prerequisites")
	check(amenities.buy("delta", "shelter", 1000) == 300 and amenities.buy("delta", "waiting_room", 1000) == 700 and amenities.queue_limit("delta") == 250, "custom station purchases give real capacity benefit")
	check(amenities.buy("a", "shelter", 1000) == -1 and amenities.owned.echo.is_empty(), "amenities cannot attach to foreign station or leak to another")
	for i in range(3): amenities.arrivals("delta", 3)
	var amenity_save: Dictionary = amenities.to_save()
	check(Amenities.valid_save(amenity_save, ids) and not Amenities.valid_save(amenity_save), "amenity state follows catalog")
	var amenity_copy := Amenities.new()
	amenity_copy.load_save(JSON.parse_string(JSON.stringify(amenity_save)), ids)
	check(amenity_copy.to_save() == amenity_save and not amenity_copy.owned.has("a"), "restore removes phantom tutorial amenities")
	var satisfaction := Satisfaction.new(ids)
	satisfaction.record("delta", [{"count": 12, "wait": 600}], 600, amenities.owned.delta)
	check(satisfaction.station("delta", [], 600, amenities.owned.delta).rating == 100 and satisfaction.company(demand, 600, amenities).count == 12, "comfort and company aggregation work beyond A/B/C")
	var history: Dictionary = satisfaction.save_state()
	check(Satisfaction.valid_state(history, 600, ids) and not Satisfaction.valid_state(history, 600), "satisfaction history validates catalog")
	var satisfaction_copy := Satisfaction.new()
	satisfaction_copy.restore_state(JSON.parse_string(JSON.stringify(history)), ids)
	check(satisfaction_copy.save_state() == history and not satisfaction_copy.history.has("a"), "history restore retains custom station evidence")
	var response := Response.new(ids)
	for i in range(25): response.arrivals("delta", 3, 100, 12, true)
	check(response.state.delta.factor == 125 and response.state.echo.factor == 100, "reliable custom service grows arrivals gradually without changing other stations")
	for i in range(80): response.arrivals("delta", 3, 0, 0, false)
	check(response.state.delta.factor == 50, "poor custom service declines to bounded demand floor")
	var response_save: Dictionary = response.save_state()
	check(Response.valid_state(response_save, ids) and not Response.valid_state(response_save), "response validates supplied identities")
	var response_copy := Response.new()
	response_copy.restore_state(JSON.parse_string(JSON.stringify(response_save)), ids)
	check(response_copy.save_state() == response_save and not response_copy.state.has("a"), "response carry and factor survive restore")
	var arrival := Arrival.new()
	arrival.depart("passenger", 1, "delta>echo", 60, 2)
	check(Arrival.valid_row(arrival.active.passenger, 60, false, ids) and not Arrival.valid_row(arrival.active.passenger, 60, false), "arrival targets accept custom legs and reject mismatched catalog")
	var occupancy := Occupancy.new()
	check(occupancy.summary(ids).contains("Station DELTA") and not occupancy.summary(ids).contains("Station A:"), "occupancy report enumerates current stations")
	var normal := Amenities.new()
	check(normal.owned.has("a") and normal.owned.a.is_empty(), "tutorial instance remains independent")
	print("Catalog station state: %d checks, %d failures" % [checks, failures])
	quit(1 if failures else 0)
